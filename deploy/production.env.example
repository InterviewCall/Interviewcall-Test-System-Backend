# Copy to /opt/interviewcall-tests/.env on the server (bootstrap-ec2.sh does this and fills the secrets in).
# This file is never committed with real values, and nothing in it is baked into the image.

# --- Image (deploy.sh keeps IMAGE_TAG up to date) ---
REGISTRY_IMAGE=ghcr.io/interviewcall/interviewcall-test-system-backend
IMAGE_TAG=latest

# --- Addresses ---
# DNS A record -> this server's Elastic IP
API_DOMAIN=test-api.interviewcall.club
# Let's Encrypt expiry notices
ACME_EMAIL=you@interviewcall.club
ALLOWED_ORIGINS=https://test.interviewcall.club,https://console.interviewcall.club
TEST_PORTAL_URL=https://test.interviewcall.club
STAFF_CONSOLE_URL=https://console.interviewcall.club
# Proxies in front of the API: Vercel + Caddy. Per-visitor rate limits depend on this being right.
TRUST_PROXY_HOPS=2

# --- Database (made by the MariaDB container the first time it starts) ---
# Hex or letters and digits only: these also go into a connection URL.
DB_ROOT_PASSWORD=__generated__
DB_NAME=entrance_test
DB_USER=entrance
DB_PASSWORD=__generated__
# about a quarter of the server's memory (2G on an 8 GB server)
DB_BUFFER_POOL=1G

# --- Redis (the notification queue) ---
REDIS_PASSWORD=__generated__
REDIS_MAXMEMORY=512mb

# --- Queue payloads are encrypted with this. Generated once; changing it strands queued jobs ---
NOTIFICATIONS_PAYLOAD_KEY=__generated__

# --- Mail (AWS SES, region ap-south-1) ---
MAIL_DRIVER=ses
AWS_REGION=ap-south-1
MAIL_FROM_ACCOUNTS="InterviewCall <accounts@notification.interviewcall.club>"
MAIL_FROM_CANDIDATES="InterviewCall Tests <tests@notification.interviewcall.club>"
SES_CONFIGURATION_SET=interviewcall-tests
MAIL_EVENTS_TOPIC_ARN=arn:aws:sns:ap-south-1:983194205581:ses-events
# Credentials: either give the instance an IAM role (preferred; see docs/deployment.md), or set both of these.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- WhatsApp (AiSensy). Production refuses to start with the console driver, so a key is needed even
# --- while the WhatsApp messages are not built yet.
WHATSAPP_DRIVER=aisensy
AISENSY_API_KEY=
# AISENSY_SOURCE=InterviewCall entrance test
# DEFAULT_PHONE_COUNTRY_CODE=91

# --- Only for the first run: docker compose run --rm seed ---
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_FULL_NAME=
# SEED_ADMIN_PHONE=
