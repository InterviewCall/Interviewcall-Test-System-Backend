# Copy to .env and fill in. Never commit .env.

PORT=4000

# --- Database (MySQL 8) ---
DATABASE_URL=mysql://USER:PASSWORD@localhost:3306/entrance_test   # used by prisma migrate / generate
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=entrance_test

# --- API ---
PORT=4000                       # Next.js dev servers default to 3000, so keep the API elsewhere
# Browser origins (the two Next.js apps) allowed to send POST/PATCH/PUT/DELETE. Required in production.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002
# Proxies in front of the API (Next rewrite, load balancer). Needed so rate limits see the real client IP.
TRUST_PROXY_HOPS=0
SWAGGER_ENABLED=true            # defaults to true outside production; keep false in production

# --- Staff session cookie ---
SESSION_COOKIE_NAME=ic_staff_session
COOKIE_SECURE=false             # defaults to true when NODE_ENV=production
COOKIE_SAMESITE=lax             # lax | strict
# COOKIE_DOMAIN=                # only if the API is on a sibling subdomain instead of behind the Next rewrite
SESSION_IDLE_MINUTES=480        # sign out after this long without activity
SESSION_ABSOLUTE_DAYS=7         # hard cap from sign-in
SESSION_TOUCH_INTERVAL_MINUTES=5

# --- First admin (npm run seed) ---
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=            # 10-128 characters
# SEED_ADMIN_FULL_NAME=
# SEED_ADMIN_PHONE=

SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-to-a-long-passphrase
SEED_ADMIN_FULL_NAME="First Admin"
SEED_ADMIN_PHONE=+911234567890

# --- Notifications (API queues jobs; the worker app sends them) ---
# Redis holds the BullMQ queues. Needed by both the API and the worker.
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_USERNAME=
# REDIS_PASSWORD=
# REDIS_DB=0
# REDIS_TLS=false
# NOTIFICATIONS_QUEUE_PREFIX=ic-entrance
# Encrypts temporary passwords while they wait in Redis. Required. Generate one with: openssl rand -base64 32
NOTIFICATIONS_PAYLOAD_KEY=
APP_NAME=InterviewCall
# Where staff sign in; used for the button in the account email.
STAFF_CONSOLE_URL=http://localhost:3000

# Mail: "console" prints emails in the worker log (development). "ses" sends through AWS SES (required in production).
MAIL_DRIVER=console
# MAIL_FROM_ACCOUNTS="InterviewCall <accounts@notification.interviewcall.club>"      # staff credentials emails
# MAIL_FROM_CANDIDATES="InterviewCall Tests <tests@notification.interviewcall.club>"  # candidate test-scheduling emails
# Both must be on verified SES identities.
# MAIL_REPLY_TO=
# AWS_REGION=ap-south-1
# SES_CONFIGURATION_SET=
# SES uses the standard AWS credential chain (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY, a profile, or an instance role).

# WhatsApp: "console" prints messages in the worker log. "aisensy" sends through AiSensy (required in production).
WHATSAPP_DRIVER=console
# AISENSY_API_KEY=
# AISENSY_API_URL=https://backend.aisensy.com/campaign/t1/api
# AISENSY_SOURCE=InterviewCall entrance test
# DEFAULT_PHONE_COUNTRY_CODE=91
