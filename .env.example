# Copy to .env and fill in. Never commit .env.

PORT=4000

# --- Database (MySQL 8) ---
DATABASE_URL=mysql://USER:PASSWORD@localhost:3306/entrance_test   # used by prisma migrate / generate
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD="1748arijiT#"
DB_NAME=entrance_test

# --- API ---
PORT=4000                       # Next.js dev servers default to 3000, so keep the API elsewhere
# Browser origins (the two Next.js apps) allowed to send POST/PATCH/PUT/DELETE. Required in production.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002
# Proxies in front of the API (Next rewrite, load balancer). Needed so rate limits see the real client IP.
TRUST_PROXY_HOPS=0
SWAGGER_ENABLED=true            # defaults to true outside production; keep false in production

# --- Staff session cookie ---
SESSION_COOKIE_NAME=ic_staff_session
COOKIE_SECURE=false             # defaults to true when NODE_ENV=production
COOKIE_SAMESITE=lax             # lax | strict
# COOKIE_DOMAIN=                # only if the API is on a sibling subdomain instead of behind the Next rewrite
SESSION_IDLE_MINUTES=480        # sign out after this long without activity
SESSION_ABSOLUTE_DAYS=7         # hard cap from sign-in
SESSION_TOUCH_INTERVAL_MINUTES=5

# --- First admin (npm run seed) ---
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=            # 10-128 characters
# SEED_ADMIN_FULL_NAME=
# SEED_ADMIN_PHONE=

SEED_ADMIN_EMAIL=arijit.ganguly@interviewcall.club
SEED_ADMIN_PASSWORD="1748arijiT#"
SEED_ADMIN_FULL_NAME="Arijit Ganguly"
SEED_ADMIN_PHONE=7044610338
