<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light">
<title>{{title}}</title>
</head>
<body style="margin:0;padding:0;background:#eef1f5;">
<div style="display:none;max-height:0;overflow:hidden;opacity:0;color:#eef1f5;">{{preheader}}</div>
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background:#eef1f5;">
  <tr>
    <td align="center" style="padding:32px 16px;">
      <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width:520px;">
        <tr>
          <td style="padding:0 4px 16px;font-family:Helvetica,Arial,sans-serif;font-size:18px;font-weight:700;color:#14213d;">
            <img src="{{testPortalUrl}}/images/ic-logo.png" width="25" height="28" alt="" style="display:inline-block;width:25px;height:28px;border:0;vertical-align:middle;margin-right:10px;"><span style="vertical-align:middle;">{{appName}}</span>
          </td>
        </tr>
        <tr>
          <td style="background:#ffffff;border:1px solid #d6dce6;border-radius:12px;padding:32px 28px;font-family:Helvetica,Arial,sans-serif;font-size:15px;line-height:1.55;color:#14213d;">
            {{> @partial-block}}
          </td>
        </tr>
        <tr>
          <td style="padding:16px 4px 0;font-family:Helvetica,Arial,sans-serif;font-size:12px;line-height:1.5;color:#67758c;">
            {{footerNote}}
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
</body>
</html>
