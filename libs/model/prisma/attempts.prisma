enum SubmitReason {
  /// The candidate pressed Submit.
  CANDIDATE
  /// The deadline passed and the server submitted whatever was saved.
  TIMEOUT
}

enum ReportStatus {
  PENDING
  READY
  FAILED
}

/// A candidate's browser session. Made when they open their link and confirm their email.
/// Only the SHA-256 of the cookie token is stored, like staff sessions.
model CandidateSession {
  id             Int       @id @default(autoincrement())
  testScheduleId Int       @map("test_schedule_id")
  tokenHash      String    @unique @map("token_hash") @db.Char(64)
  ip             String?   @db.VarChar(45)
  userAgent      String?   @map("user_agent") @db.VarChar(255)
  createdAt      DateTime  @default(now()) @map("created_at")
  expiresAt      DateTime  @map("expires_at")
  revokedAt      DateTime? @map("revoked_at")

  testSchedule TestSchedule @relation(fields: [testScheduleId], references: [id], onDelete: Cascade)

  @@index([testScheduleId])
  @@index([expiresAt])
  @@map("candidate_sessions")
}

/// The candidate's one run at their test. The server sets the clock: startedAt and deadlineAt are never taken from the browser.
model Attempt {
  id                  Int           @id @default(autoincrement())
  testScheduleId      Int           @unique @map("test_schedule_id")
  /// The exact version of the test they were given. It never changes after the start.
  templateVersionId   Int           @map("template_version_id")
  startedAt           DateTime      @map("started_at")
  /// startedAt plus the test length. Answers are accepted up to ten seconds after it.
  deadlineAt          DateTime      @map("deadline_at")
  submittedAt         DateTime?     @map("submitted_at")
  submitReason        SubmitReason? @map("submit_reason")
  workExperienceYears Float         @map("work_experience_years")
  declaredAt          DateTime      @map("declared_at")
  /// The question versions they were asked, in order: [questionVersionId, ...]. Scoring reads this, not the template.
  questionOrder       Json          @map("question_order")
  /// Touched on every saved answer. It makes saving and submitting take turns on this row, so an answer can never land after scoring.
  lastSavedAt         DateTime?     @map("last_saved_at")
  ip                  String?       @db.VarChar(45)
  userAgent           String?       @map("user_agent") @db.VarChar(255)
  createdAt           DateTime      @default(now()) @map("created_at")

  testSchedule    TestSchedule    @relation(fields: [testScheduleId], references: [id], onDelete: Restrict)
  templateVersion TemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)
  answers         AttemptAnswer[]
  result          Result?
  feedback        Feedback?

  /// The worker looks for open attempts whose deadline has passed.
  @@index([submittedAt, deadlineAt])
  @@index([templateVersionId])
  @@map("attempts")
}

/// One row per question the candidate has touched. A cleared answer keeps its row with no option.
model AttemptAnswer {
  id                Int      @id @default(autoincrement())
  attemptId         Int      @map("attempt_id")
  questionVersionId Int      @map("question_version_id")
  selectedOptionId  Int?     @map("selected_option_id")
  answeredAt        DateTime @map("answered_at")
  /// Filled in when the attempt is scored. Null before.
  isCorrect         Boolean? @map("is_correct")
  marksAwarded      Int?     @map("marks_awarded")

  attempt         Attempt         @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionVersion QuestionVersion @relation(fields: [questionVersionId], references: [id], onDelete: Restrict)
  selectedOption  QuestionOption? @relation(fields: [selectedOptionId], references: [id], onDelete: Restrict)

  @@unique([attemptId, questionVersionId])
  @@index([questionVersionId])
  @@index([selectedOptionId])
  @@map("attempt_answers")
}

/// The score, written once when the attempt is submitted.
model Result {
  id             Int          @id @default(autoincrement())
  attemptId      Int          @unique @map("attempt_id")
  totalMarks     Int          @map("total_marks")
  obtainedMarks  Int          @map("obtained_marks")
  /// Two decimals. passed compares this to the template's pass mark, nowhere else.
  percentage     Decimal      @db.Decimal(5, 2)
  passed         Boolean
  /// [{ topicId, topic, questions, answered, correct, totalMarks, obtainedMarks }]
  sectionScores  Json         @map("section_scores")
  /// The report card PDF in the private bucket. Null until it has been made.
  reportFileKey  String?      @map("report_file_key") @db.VarChar(255)
  reportStatus   ReportStatus @default(PENDING) @map("report_status")
  reportAttempts Int          @default(0) @map("report_attempts")
  reportError    String?      @map("report_error") @db.VarChar(500)
  reportReadyAt  DateTime?    @map("report_ready_at")
  createdAt      DateTime     @default(now()) @map("created_at")

  attempt Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([reportStatus, createdAt])
  @@map("results")
}

/// The candidate's star rating after they submit.
model Feedback {
  id        Int      @id @default(autoincrement())
  attemptId Int      @unique @map("attempt_id")
  rating    Int
  comment   String?  @db.VarChar(1000)
  createdAt DateTime @default(now()) @map("created_at")

  attempt Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@map("feedback")
}
