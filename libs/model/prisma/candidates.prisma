enum TestLevel {
    INTERMEDIATE
    ADVANCED
}

enum TestStatus {
    INVITED
    IN_PROGRESS
    SUBMITTED
    EXPIRED
}

/// A person who takes the entrance test. One row per email address.
model Candidate {
    id        Int      @id @default(autoincrement())
    fullName  String   @map("full_name") @db.VarChar(150)
    email     String   @unique
    phone     String?  @db.VarChar(50)
    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    testSchedule TestSchedule?

    @@map("candidates")
}

/// A candidate's scheduled test. A candidate has at most one; rescheduling edits it.
model TestSchedule {
    id          Int       @id @default(autoincrement())
    candidateId Int       @unique @map("candidate_id")
    /// The advisor or admin who scheduled it.
    invitedById Int       @map("invited_by_id")
    level       TestLevel
    /// Fixed from the level when scheduled, so changing the level durations later never alters booked tests.
    durationMinutes Int   @map("duration_minutes")
    /// The window in which the candidate may start. Stored in UTC.
    startsAt    DateTime  @map("starts_at")
    endsAt      DateTime  @map("ends_at")
    status      TestStatus @default(INVITED)
    /// When the invitation email was last put on the queue. Null: it never was, so resend it.
    invitationQueuedAt DateTime? @map("invitation_queued_at")
    createdAt   DateTime  @default(now()) @map("created_at")
    updatedAt   DateTime  @updatedAt @map("updated_at")

    candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
    invitedBy User      @relation(fields: [invitedById], references: [id], onDelete: Restrict)

    @@index([invitedById, startsAt])
    @@index([status, endsAt])
    @@index([startsAt])
    @@map("test_schedules")
}
